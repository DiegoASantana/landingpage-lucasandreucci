# Modelo de configuracao do Endpoint_de_Envio.
# Copie para .env (nao versionado) e preencha com os valores reais.
# Nenhum valor real de segredo deve entrar neste arquivo (DD-05, Requisito 3.6).
#
# OBRIGATORIAS (as cinco primeiras): sem qualquer uma delas a inicializacao
# falha de forma decidivel — `npm run verificar-config` sai com codigo 1 e
# importar src/index.js lanca ErroDeConfiguracao. Variavel vazia ou so com
# espacos conta como ausente.
# OPCIONAIS (as duas ultimas): tem padrao documentado e geram aviso no log de
# inicializacao quando ausentes — nunca silencio.

# [OBRIGATORIA] Chave de API do Provedor_de_Envio (Resend). Existe SOMENTE como
# variavel de ambiente do processo server-side; nunca em codigo versionado nem
# em qualquer arquivo servido ao navegador. Sem padrao possivel.
RESEND_API_KEY=

# [OBRIGATORIA] Endereco de e-mail do Dr. Lucas que recebe a Notificacao_por_Email.
EMAIL_DESTINO_DR_LUCAS=

# [OBRIGATORIA] Remetente da Notificacao_por_Email. Precisa usar um dominio
# verificado no painel do Resend (pre-requisito de configuracao, fora do codigo).
EMAIL_REMETENTE=

# [OBRIGATORIA] URL do projeto Supabase que guarda o Consentimento_LGPD.
# Formato: https://<referencia-do-projeto>.supabase.co
SUPABASE_URL=

# [OBRIGATORIA] Service role key do Supabase. SEGREDO server-side: ignora as
# policies de RLS da tabela, portanto NUNCA pode ir para o navegador (HTML/JS
# servido ao cliente), nunca ser versionada e nunca aparecer em log. Se vazar,
# revogue no painel do Supabase. Nao confundir com a chave anon/publishable.
SUPABASE_SERVICE_ROLE_KEY=

# [OPCIONAL] Tempo limite do envio da Notificacao_por_Email, em milissegundos.
# Vazio ou invalido = 10000 ms. Estourar o limite e tratado como falha de envio
# (502 falha_envio), sem desfazer o registro de consentimento (Requisito 3.5).
TIMEOUT_ENVIO_EMAIL_MS=

# [OPCIONAL] Tabela do Consentimento_LGPD no Supabase.
# Vazio = consentimentos_lgpd (a tabela criada por supabase/consentimentos.sql).
SUPABASE_TABELA_CONSENTIMENTOS=
